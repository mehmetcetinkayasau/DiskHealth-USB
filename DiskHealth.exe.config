<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- Built for .NET 3.5 (CLR 2.0, ships with Windows 7). On machines that only have .NET 4.x the second entry
         lets the same exe run on CLR 4 without any installation. -->
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>