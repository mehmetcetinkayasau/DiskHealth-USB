{
  "schemaVersion": 1,
  "version": "2.0",
  "rules": [
    { "id": "smart.failed", "group": "smart_status", "metric": "smart_passed", "op": "isFalse", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "any", "message": "Diskin kendi S.M.A.R.T. genel sağlık testi BAŞARISIZ. Disk değiştirilmeli." },
    { "id": "wmi.predict_failure", "group": "predict_failure", "metric": "predict_failure", "op": "isTrue", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "any", "message": "Windows arıza tahmini (Predict Failure) bayrağı aktif. Disk değiştirilmeli." },
    { "id": "ata.prefail.now", "group": "prefail", "metric": "prefail_failing_now", "op": "isTrue", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "En az bir S.M.A.R.T. özniteliği eşik değerinin altına düştü (FAILING_NOW)." },
    { "id": "ata.prefail.past", "group": "prefail", "metric": "prefail_failed_past", "op": "isTrue", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Geçmişte eşik altına düşmüş S.M.A.R.T. özniteliği var (In_the_past)." },
    { "id": "selftest.failed", "group": "selftest", "metric": "selftest_failed_recent", "op": "isTrue", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "any", "message": "Diskin son disk içi testi (self-test) başarısız." },
    { "id": "selftest.failed.old", "group": "selftest", "metric": "selftest_failed_old", "op": "isTrue", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "any", "message": "Geçmişte (diskin çalışma sayacına göre 1000+ saat önce) başarısız bir disk içi test kaydı var. Derin testle güncel durumu doğrulayın." },

    { "id": "ata.reallocated.warn", "group": "reallocated", "metric": "reallocated_sectors", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Yeniden atanan (reallocated) sektör sayısı: {value}. Disk yıpranmaya başlamış, yakından izlenmeli." },
    { "id": "ata.reallocated.crit", "group": "reallocated", "metric": "reallocated_sectors", "op": "gte", "value": 100, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "Yeniden atanan (reallocated) sektör sayısı: {value}. Disk değiştirilmeli." },
    { "id": "ata.pending.warn", "group": "pending", "metric": "pending_sectors", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Bekleyen (pending) sektör sayısı: {value}. Okunamayan sektörler var." },
    { "id": "ata.pending.crit", "group": "pending", "metric": "pending_sectors", "op": "gte", "value": 10, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "Bekleyen (pending) sektör sayısı: {value}. Disk değiştirilmeli." },
    { "id": "ata.uncorrectable.warn", "group": "uncorrectable", "metric": "offline_uncorrectable", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Düzeltilemeyen (offline uncorrectable) sektör sayısı: {value}." },
    { "id": "ata.uncorrectable.crit", "group": "uncorrectable", "metric": "offline_uncorrectable", "op": "gte", "value": 10, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "Düzeltilemeyen (offline uncorrectable) sektör sayısı: {value}. Disk değiştirilmeli." },
    { "id": "ata.reported_uncorrect.warn", "group": "reported_uncorrect", "metric": "reported_uncorrect", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Düzeltilemeyen okuma/yazma hatası bildirimi (Reported_Uncorrect): {value}." },
    { "id": "ata.reported_uncorrect.crit", "group": "reported_uncorrect", "metric": "reported_uncorrect", "op": "gte", "value": 100, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "Düzeltilemeyen hata bildirimi (Reported_Uncorrect): {value}. Disk değiştirilmeli." },
    { "id": "ata.end_to_end", "group": "end_to_end", "metric": "end_to_end_errors", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Uçtan uca veri hatası (End-to-End_Error): {value}. Disk önbelleği/veri yolu sorunlu olabilir." },
    { "id": "ata.spin_retry", "group": "spin_retry", "metric": "spin_retry", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "hdd", "message": "Motor dönüş yeniden deneme sayısı (Spin_Retry_Count): {value}. Mekanik sorun belirtisi." },
    { "id": "ata.command_timeout", "group": "command_timeout", "metric": "command_timeout", "op": "gt", "value": 100, "severity": "Warning", "category": "Connection", "appliesTo": "ata", "message": "Komut zaman aşımı sayısı yüksek ({value}). Kablo, port veya güç sorunu olabilir." },
    { "id": "ata.crc.info", "group": "crc", "metric": "crc_errors", "op": "gt", "value": 0, "severity": "Info", "category": "Connection", "appliesTo": "ata", "message": "CRC hata sayısı: {value}. Genellikle SATA kablosu/port kaynaklıdır, diskin kendisi değil. Kabloyu kontrol edin." },
    { "id": "ata.crc.warn", "group": "crc", "metric": "crc_errors", "op": "gte", "value": 1000, "severity": "Warning", "category": "Connection", "appliesTo": "ata", "message": "CRC hata sayısı çok yüksek ({value}). SATA kablosunu/portu değiştirin." },
    { "id": "ata.error_log", "group": "ata_error_log", "metric": "ata_error_log_count", "op": "gte", "value": 50, "severity": "Info", "category": "Info", "appliesTo": "ata", "message": "ATA hata günlüğünde {value} kayıt var." },
    { "id": "ata.raw_undecodable", "group": "raw_undecodable", "metric": "raw_undecodable", "op": "isTrue", "value": 0, "severity": "Info", "category": "Info", "appliesTo": "ata", "message": "Bazı S.M.A.R.T. sayaçlarının ham değeri üreticiye özel biçimde olduğu için çözümlenemedi ve karara dahil edilmedi. Hangi sayaçlar olduğu Notlar sekmesinde yazar." },

    { "id": "nvme.critical.spare", "group": "nvme_critical_spare", "metric": "nvme_critical_warning", "op": "bitSet", "value": 1, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "NVMe kritik uyarı: yedek alan eşiğin altında." },
    { "id": "nvme.critical.temp", "group": "nvme_critical_temp", "metric": "nvme_critical_warning", "op": "bitSet", "value": 2, "severity": "Warning", "category": "Environment", "appliesTo": "nvme", "message": "NVMe kritik uyarı: sıcaklık eşiği aşıldı." },
    { "id": "nvme.critical.reliability", "group": "nvme_critical_reliability", "metric": "nvme_critical_warning", "op": "bitSet", "value": 4, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "NVMe kritik uyarı: güvenilirlik düştü (medya hataları). Disk değiştirilmeli." },
    { "id": "nvme.critical.readonly", "group": "nvme_critical_readonly", "metric": "nvme_critical_warning", "op": "bitSet", "value": 8, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "NVMe kritik uyarı: disk salt okunur moda geçti. Disk değiştirilmeli." },
    { "id": "nvme.critical.backup", "group": "nvme_critical_backup", "metric": "nvme_critical_warning", "op": "bitSet", "value": 16, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "NVMe kritik uyarı: uçucu bellek yedek cihazı arızalı." },
    { "id": "nvme.spare.below_threshold", "group": "spare", "metric": "spare_below_threshold", "op": "isTrue", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "Kullanılabilir yedek alan üretici eşiğinin altında. Disk değiştirilmeli." },
    { "id": "nvme.spare.low", "group": "spare", "metric": "available_spare_percent", "op": "lt", "value": 20, "severity": "Warning", "category": "Replacement", "appliesTo": "nvme", "message": "Kullanılabilir yedek alan düşük: %{value}." },
    { "id": "nvme.spare.critical", "group": "spare", "metric": "available_spare_percent", "op": "lt", "value": 10, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "Kullanılabilir yedek alan kritik seviyede: %{value}. Disk değiştirilmeli." },
    { "id": "nvme.media_errors.warn", "group": "media_errors", "metric": "media_errors", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "nvme", "message": "NVMe medya hatası sayısı: {value}." },
    { "id": "nvme.media_errors.crit", "group": "media_errors", "metric": "media_errors", "op": "gte", "value": 10, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "NVMe medya hatası sayısı: {value}. Disk değiştirilmeli." },

    { "id": "wear.warn", "group": "wear", "metric": "wear_percent_used", "op": "gte", "value": 80, "severity": "Warning", "category": "Replacement", "appliesTo": "ssd", "message": "SSD aşınma seviyesi %{value}. Ömrünün sonuna yaklaşıyor, değişim planlanmalı." },
    { "id": "wear.crit", "group": "wear", "metric": "wear_percent_used", "op": "gte", "value": 95, "severity": "Critical", "category": "Replacement", "appliesTo": "ssd", "message": "SSD aşınma seviyesi %{value}. Disk değiştirilmeli." },

    { "id": "temp.hdd.warn", "group": "temperature", "metric": "temperature_c", "op": "gte", "value": 50, "severity": "Warning", "category": "Environment", "appliesTo": "hdd", "message": "Disk sıcaklığı yüksek: {value} °C. Soğutmayı kontrol edin." },
    { "id": "temp.hdd.crit", "group": "temperature", "metric": "temperature_c", "op": "gte", "value": 60, "severity": "Critical", "category": "Environment", "appliesTo": "hdd", "message": "Disk sıcaklığı kritik: {value} °C. Soğutma sorunu, disk ömrünü kısaltır." },
    { "id": "temp.ssd.warn", "group": "temperature", "metric": "temperature_c", "op": "gte", "value": 65, "severity": "Warning", "category": "Environment", "appliesTo": "ssd", "message": "SSD sıcaklığı yüksek: {value} °C. Soğutmayı kontrol edin." },
    { "id": "temp.ssd.crit", "group": "temperature", "metric": "temperature_c", "op": "gte", "value": 75, "severity": "Critical", "category": "Environment", "appliesTo": "ssd", "message": "SSD sıcaklığı kritik: {value} °C. Soğutma sorunu." },

    { "id": "age.hdd.info", "group": "age", "metric": "power_on_hours", "op": "gte", "value": 43800, "severity": "Info", "category": "Info", "appliesTo": "hdd", "message": "Disk {value} saattir çalışıyor (5 yıldan fazla). Yaşlanmış disk." },
    { "id": "age.hdd.warn", "group": "age", "metric": "power_on_hours", "op": "gte", "value": 61320, "severity": "Info", "category": "Info", "appliesTo": "hdd", "message": "Disk {value} saattir çalışıyor (7 yıldan fazla). Yaş tek başına arıza kanıtı değildir; proaktif değişim planlanmalı." },
    { "id": "age.ssd.info", "group": "age", "metric": "power_on_hours", "op": "gte", "value": 43800, "severity": "Info", "category": "Info", "appliesTo": "ssd", "message": "SSD {value} saattir çalışıyor (5 yıldan fazla)." },

    { "id": "read.error", "group": "read_test", "metric": "read_test_errors", "op": "gt", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "any", "message": "Okuma testinde {value} blok okunamadı (G/Ç hatası). Disk bugün veri okuyamıyor; S.M.A.R.T. temiz olsa bile kullanılmamalı." },
    { "id": "read.timeout", "group": "read_test", "metric": "read_test_timeouts", "op": "gt", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "any", "message": "Okuma testinde {value} blok zaman aşımına uğradı (30 sn). Disk yanıt vermiyor; kullanılmamalı." },
    { "id": "read.stalls.hdd", "group": "read_stalls", "metric": "read_test_stalls", "op": "gte", "value": 3, "severity": "Warning", "category": "Replacement", "appliesTo": "hdd", "message": "Okuma testinde {value} blokta ciddi takılma (2 sn üstü). Zor okunan bölgeler var; yedek alın, değişim planlayın." },
    { "id": "read.stalls.ssd", "group": "read_stalls", "metric": "read_test_stalls", "op": "gte", "value": 1, "severity": "Warning", "category": "Replacement", "appliesTo": "ssd", "message": "Okuma testinde {value} blokta takılma (2 sn üstü). SSD için olağan dışı; yedek alın, izleyin." },
    { "id": "read.slow_region", "group": "read_slow", "metric": "read_test_min_ratio", "op": "lt", "value": 0.2, "severity": "Warning", "category": "Replacement", "appliesTo": "hdd", "message": "Okuma testinde bir bölge diskin kendi ortalamasından 5 kat daha yavaş. Zayıflayan yüzey belirtisi; izlenmeli." },
    { "id": "read.delta.pending", "group": "delta_pending", "metric": "delta_pending", "op": "gt", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "Okuma testi sırasında {value} yeni bekleyen (okunamayan) sektör oluştu. Disk yüzeyi şu anda bozuluyor; kullanılmamalı." },
    { "id": "read.delta.reallocated", "group": "delta_reallocated", "metric": "delta_reallocated", "op": "gt", "value": 0, "severity": "Warning", "category": "Replacement", "appliesTo": "ata", "message": "Okuma testi sırasında {value} sektör yeniden atandı. Disk aktif olarak yıpranıyor; yedek alın." },
    { "id": "read.delta.uncorrect", "group": "delta_uncorrect", "metric": "delta_reported_uncorrect", "op": "gt", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "ata", "message": "Okuma testi sırasında {value} düzeltilemeyen hata bildirildi. Disk kullanılmamalı." },
    { "id": "read.delta.media", "group": "delta_media", "metric": "delta_media_errors", "op": "gt", "value": 0, "severity": "Critical", "category": "Replacement", "appliesTo": "nvme", "message": "Okuma testi sırasında {value} yeni NVMe medya hatası oluştu. Disk kullanılmamalı." },
    { "id": "read.delta.crc", "group": "delta_crc", "metric": "delta_crc", "op": "gt", "value": 0, "severity": "Warning", "category": "Connection", "appliesTo": "ata", "message": "Okuma testi sırasında {value} yeni CRC hatası oluştu: kablo/port sorunu ŞU ANDA yaşanıyor. Kabloyu değiştirip tekrar test edin." },

    { "id": "media.unknown", "group": "media_unknown", "metric": "media_unknown", "op": "isTrue", "value": 0, "severity": "Info", "category": "Info", "appliesTo": "any", "message": "Disk türü (HDD/SSD) belirlenemedi; türe özel kurallar (sıcaklık, takılma, aşınma, yaş) uygulanmadı. Diski doğrudan SATA bağlantısıyla tekrar tarayın." },
    { "id": "partial_data", "group": "partial_data", "metric": "data_partial", "op": "isTrue", "value": 0, "severity": "Info", "category": "Info", "appliesTo": "any", "message": "S.M.A.R.T. verisi eksik/kısmi alındı (komut hatası veya öznitelik tablosu yok). Bu sonuç tek başına 'iyi' saymak için yeterli değil; taramayı tekrarlayın." },
    { "id": "no_smart", "group": "no_smart", "metric": "has_smart_data", "op": "isFalse", "value": 0, "severity": "Info", "category": "Info", "appliesTo": "any", "message": "S.M.A.R.T. verisi alınamadı. Disk RAID denetleyici/USB kutusu arkasında ya da sanal olabilir; manuel kontrol gerekir." },
    { "id": "vm", "group": "vm", "metric": "is_vm", "op": "isTrue", "value": 0, "severity": "Info", "category": "Info", "appliesTo": "any", "message": "Bu bir sanal makine. Fiziksel disk sağlığı hipervizör/sunucu tarafında kontrol edilmeli." }
  ]
}
